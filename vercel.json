{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/uploads/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/login", "destination": "/frontend/admin/login.html" },
    { "source": "/admin", "destination": "/frontend/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/frontend/admin/$1" },
    { "source": "/products/(.*)", "destination": "/frontend/products/$1" },
    { "source": "/(.*)", "destination": "/frontend/$1" }
  ]
}
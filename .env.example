# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blueneedle_db

# CORS Configuration
CLIENT_URL=http://localhost:3000

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES_IN=24h

# Email Notification Configuration (Gmail or Custom SMTP)
# For Gmail: Use your Gmail address and 16-character Google App Password (not your normal password)
# Generate App Password at: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=blueneedle3@gmail.com
EMAIL_PASS=your_16_char_google_app_password
ADMIN_EMAIL=blueneedle3@gmail.com
EMAIL_FROM=blueneedle3@gmail.com

# Optional: Custom SMTP (if not using Gmail service)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=blueneedle3@gmail.com
# SMTP_PASS=your_smtp_password

